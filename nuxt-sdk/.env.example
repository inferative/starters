# The variables of a local run. Copy this file to `.env` and fill it. Never commit `.env`.
# The two NUXT_PUBLIC_ values reach the browser. Every other value stays on your machine and in the deploy step.

# The API of the Inferative deployment, with its `/api` mount, for example https://cms.example.com/api.
NUXT_PUBLIC_INFERATIVE_API_BASE_URL=

# The public key of the channel (pk_). It selects the channel and grants no right.
NUXT_PUBLIC_INFERATIVE_CHANNEL_KEY=

# The Identifier of the channel: the namespace that the manifest adds to each local type key.
INFERATIVE_SITE_CHANNEL_ID=

# The name of the website that the manifest records.
INFERATIVE_SITE_NAME=

# The Channel ID that `pnpm sync:manifest` publishes to (not the Identifier above).
INFERATIVE_SITE_SYNC_CHANNEL_ID=

# The API that `pnpm sync:manifest` publishes to, with its `/api` mount. Usually the same as the first value.
INFERATIVE_SITE_SYNC_API_BASE_URL=

# SECRET. The sync key of the channel (ak_, with channels:manifest). Only `pnpm sync:manifest` reads it.
INFERATIVE_MANIFEST_TOKEN=
