# Dependencies and build output
node_modules
.nuxt
.output
.wrangler
dist

# Generated by the Heximon compiler (heximon.upgrade.json stays: it is the record of the durable surface)
.heximon
.heximon-test-*

# Local files: secrets never go into the repository
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
.data

# The progress file of the setup skill: ids and names, no secrets, local to one machine
.inferative

# Baked by the build of the Worker that runs the applets, from node_modules: the packages that an applet may import
server/applets/forge-kit.generated.js
