{
  "name": "my-inferative-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:visual-editing": "nitro build workers/visual-editing",
    "build:applets": "nitro build workers/applets",
    "typecheck": "nuxt typecheck",
    "heximon:check": "heximon check",
    "db:generate": "NODE_ENV=development drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "deploy:live": "wrangler deploy --config .output/server/wrangler.json",
    "deploy:visual-editing": "wrangler deploy --config workers/visual-editing/.output/server/wrangler.json",
    "deploy:applets": "wrangler deploy --config workers/applets/.output/server/wrangler.json",
    "detach:routes": "node workers/detach-routes.ts",
    "transfer:durable-objects": "node workers/transfer-durable-objects.ts",
    "test": "vitest --run"
  },
