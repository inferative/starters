# The variables of a local run. Copy this file to `.env` and fill it. Never commit `.env`.
# A deployed Worker takes its secrets from `wrangler secret bulk`, not from this file: README.md lists them.
# Any package setting changes through INFERATIVE_<SECTION>_<PATH> (upper snake case; a list takes JSON).
# Outside production an empty secret falls back to a value for one boot. A production Worker refuses to boot
# without it.

# The direct connection string of the database. A local run reads and writes the hosted database over it.
# Migrations run over it when the app starts, and in CI before each deploy. The Worker uses Hyperdrive instead.
DATABASE_URL=

# Do not run the scheduled jobs in a local run: only the deployed Worker has a cron trigger.
HEXIMON_SCHEDULE=off

# The public origin of the dashboard. The OAuth issuer and every address of the API derive from it.
INFERATIVE_APP_ORIGIN=http://localhost:3000

# The ES256 key that signs sessions and tokens (a base64 private JWK).
INFERATIVE_IDENTITY_SIGNING_KEY=

# The AES-256 key (base64url, 32 bytes) that seals the secrets of two-factor sign-in.
INFERATIVE_IDENTITY_MFA_ENCRYPTION_KEY=

# The one-time token that the first-run step of the sign-in page asks for. Delete it from the Worker after the first run.
INFERATIVE_IDENTITY_SETUP_TOKEN=

# The list of signing keys of preview links: [{ "kid": "key-1", "secret": "<base64url secret, 32 bytes or more>" }].
# The first key signs.
INFERATIVE_BASE_SIGNED_ACCESS_SIGNING_KEYS=

# The HMAC secret, at least 32 characters, that signs every realtime subscription ticket.
INFERATIVE_REALTIME_TICKET_SECRET=

# The key that encrypts the stored model history of the assistant: 32 random bytes, base64url.
INFERATIVE_ASSISTANT_HISTORY_ENCRYPTION_KEY=

# The keys of the secret store: [{ "id": "key-1", "material": "<32 random bytes, base64>", "current": true,
# "derive": true }]. Exactly one key is current. The key marked derive is never rotated away.
INFERATIVE_SECRETS_KEYS=

# Set to true to run one organization: the first-run step creates it and nobody creates another.
INFERATIVE_IDENTITY_ORGANIZATION_SINGLE_ORGANIZATION=

# Optional: the id of our own organization, the one that runs this deployment. With no stored plan it reads the
# Business plan instead of Work. Set it on the Worker after the first run; empty, every organization starts on Work.
INFERATIVE_BASE_TIERS_OWN_ORGANIZATION_ID=

# The address that every mail of the dashboard comes from: an invitation, a password reset. Your mail provider must
# accept it. With no provider, no mail goes out, and a local run prints each mail and its links in the log. To add a
# provider, read "Send email" in README.md.
INFERATIVE_NOTIFICATIONS_SENDER_EMAIL=

# The passkey settings: the registrable domain, and the list of origins that a sign-in may come from. Empty, they take
# the host name and the origin of INFERATIVE_APP_ORIGIN.
INFERATIVE_IDENTITY_WEBAUTHN_RP_ID=localhost
INFERATIVE_IDENTITY_WEBAUTHN_ALLOWED_ORIGINS=["http://localhost:3000"]

# The origins of the websites of your channels, as a JSON list. They may call the channel routes, and the visual
# editor frames them.
INFERATIVE_CHANNELS_ADMINISTRATION_ORIGINS=

# More browser origins that may call /api/mcp, as a JSON list, beside the origin of the dashboard.
INFERATIVE_MCP_ALLOWED_ORIGINS=

# The model of the assistant: the driver (anthropic or gateway), its key and the model id. Empty, the assistant is off.
INFERATIVE_ASSISTANT_BACKEND_DRIVER=
INFERATIVE_ASSISTANT_BACKEND_API_KEY=
INFERATIVE_ASSISTANT_BACKEND_MODEL=

# The vendors that may receive data from a model call, as a JSON list: ["anthropic"] for the anthropic driver, the
# prefix of the model id (["google"] for google/gemini-...) for the gateway driver. A vendor that is not listed gets
# no call.
INFERATIVE_BASE_PROCESSING_MODEL=

# Local development reaches the R2 bucket of the dashboard through its S3 API. Create an R2 access key in the
# Cloudflare dashboard (R2 object storage, Manage API tokens, Create API token): Object Read & Write on this bucket
# only. The dashboard shows the key id and the secret once. The account id is on the R2 overview page. With none of
# the four set, a local run keeps files in memory and prints one warning. Set all four or none.
INFERATIVE_FILES_R2_ACCOUNT_ID=
INFERATIVE_FILES_R2_BUCKET=
INFERATIVE_FILES_R2_ACCESS_KEY_ID=
INFERATIVE_FILES_R2_SECRET_ACCESS_KEY=
