# The variables of a local run. Copy this file to `.env` and never commit it. The Worker takes its secrets from
# `wrangler secret bulk` (README.md, "Secrets"). A package setting changes through INFERATIVE_<SECTION>_<PATH>.

# 32 random bytes in base64. Every other secret derives from it. Use the same value on the Worker.
INFERATIVE_ROOT_SECRET=

# The origins of the websites of your channels, as a JSON list.
INFERATIVE_CHANNELS_ADMINISTRATION_ORIGINS=

# ---- Local run only. None of these values goes to the Worker. ----

# The direct connection string that drizzle-kit, the migrations and the backup read; not a package setting.
DATABASE_URL=

# Only the deployed Worker runs the scheduled jobs.
HEXIMON_SCHEDULE=off

# An R2 access key of the files bucket (README.md, "Cloudflare"). Set all four or none: with none, files stay in memory.
INFERATIVE_FILES_R2_ACCOUNT_ID=
INFERATIVE_FILES_R2_BUCKET=
INFERATIVE_FILES_R2_ACCESS_KEY_ID=
INFERATIVE_FILES_R2_SECRET_ACCESS_KEY=
