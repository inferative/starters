# The variables of a local run. Copy this file to `.env` and fill it. Never commit `.env`.
# A deployed Worker takes its values from `wrangler secret bulk`, not from this file: README.md, "Secrets", lists them.
# The first part holds the values that the Worker needs too. The second part, "Local run only", never goes to the
# Worker.
# Any package setting changes through INFERATIVE_<SECTION>_<PATH> (upper snake case; a list takes JSON).
# Outside production an empty secret falls back to a value for one boot. A production Worker refuses to boot
# without it.

# The root secret: 32 random bytes, base64. The setup token, the signing keys of preview links, the realtime ticket
# secret and the webhook secret of the member chat derive from it, so their own variables below may stay empty. A
# variable of its own wins over the root. The keys at rest derive from it too: the MFA key, the model history key and
# the current key of the secret store. For those three the root wins: an older key that you set before only decrypts
# what it sealed, so keep it until its data is sealed again (README.md, "Secrets"). A backup restores only with the
# same root, or with the older keys that sealed its values. To rotate the root, move the old value to
# INFERATIVE_ROOT_SECRET_PREVIOUS: the links, sessions and runner receipts that it signed keep working, its keys still
# decrypt, and nothing new is signed or sealed with it. Keep the previous value for 30 days, until `pnpm secrets:rewrap`
# reports no value under its key, until `pnpm mfa:reseal` reports no remaining secret, for as long as you may restore
# a backup from before the rotation, for as long as the install keeps model history that the previous root sealed (that
# history is never sealed again), while an agent session open before the rotation is still open, and while an account
# mail queued before it still waits in the outbox (README.md, "Secrets").
# `pnpm exec inferative setup-token` prints the setup token that the root gives.
INFERATIVE_ROOT_SECRET=

# The ES256 key that signs sessions and tokens (a base64 private JWK).
INFERATIVE_IDENTITY_SIGNING_KEY=

# The AES-256 key (base64url, 32 bytes) that sealed the secrets of two-factor sign-in before the root. Empty for a new
# install: it derives from INFERATIVE_ROOT_SECRET. Set, with the root: it only decrypts, and a secret is sealed again
# under the root's key at its next use. `pnpm mfa:reseal` seals every secret again at once; remove the key when it
# reports no remaining secret and no account mail queued before the change still waits in the outbox.
INFERATIVE_IDENTITY_MFA_ENCRYPTION_KEY=

# The one-time token that the first-run step of the sign-in page asks for. Delete it from the Worker after the first run.
# Empty: it derives from INFERATIVE_ROOT_SECRET.
INFERATIVE_IDENTITY_SETUP_TOKEN=

# The list of signing keys of preview links: [{ "kid": "key-1", "secret": "<base64url secret, 32 bytes or more>" }].
# The first key signs. Empty: it derives from INFERATIVE_ROOT_SECRET.
INFERATIVE_BASE_SIGNED_ACCESS_SIGNING_KEYS=

# The HMAC secret, at least 32 characters, that signs every realtime subscription ticket. Empty: it derives from
# INFERATIVE_ROOT_SECRET.
INFERATIVE_REALTIME_TICKET_SECRET=

# The key that encrypted the stored model history of the assistant before the root: 32 random bytes, base64url. Empty
# for a new install: it derives from INFERATIVE_ROOT_SECRET. Set, with the root: it only decrypts. The history is
# never sealed again, and an active conversation keeps its rows with no end, so keep this key for as long as the
# install keeps the history that it sealed, and until every agent session open before the change has ended or started
# a new epoch: a runner session token derives from this key and lives as long as its session stays open.
INFERATIVE_ASSISTANT_HISTORY_ENCRYPTION_KEY=

# The keys of the secret store before the root: [{ "id": "key-1", "material": "<32 random bytes, base64>",
# "current": true, "derive": true }]. Empty for a new install: the current key derives from INFERATIVE_ROOT_SECRET.
# Set, with the root: each key only decrypts what it sealed, and the key marked derive stays the root of the derived
# webhook secrets of agent bots. `pnpm secrets:rewrap` seals every value again under the root's key and keeps the
# derive root; remove the list when it reports no value under a listed key.
INFERATIVE_SECRETS_KEYS=

# Set to true to run one organization: the first-run step creates it and nobody creates another.
INFERATIVE_IDENTITY_ORGANIZATION_SINGLE_ORGANIZATION=

# The address that every mail of the dashboard comes from: an invitation, a password reset. Your mail provider must
# accept it. With no provider, no mail goes out, and a local run prints each mail and its links in the log. To add a
# provider, read "Send email" in README.md.
INFERATIVE_NOTIFICATIONS_SENDER_EMAIL=

# The linked Telegram chat of a member: the secret that Telegram sends with each update (1 to 256 of A-Z, a-z, 0-9, _
# and -), and the token of the bot. An empty webhook secret derives from INFERATIVE_ROOT_SECRET. Save the token under
# Settings > Organization > Credentials instead of here: the screen asks Telegram for the user name of the bot and
# registers the webhook. The token below applies only while none is saved there. README.md, "Telegram", says more.
INFERATIVE_NOTIFICATIONS_CHAT_TELEGRAM_BOT_TOKEN=
INFERATIVE_NOTIFICATIONS_CHAT_TELEGRAM_WEBHOOK_SECRET=

# The GitHub App of the deployment: its App ID, its private key (the text of the .pem file, in double quotes on one
# line with \n for each line break) and its webhook secret. The App reports a failed CI check of an agent's commit
# and gives the write token of a push. Empty, no installation gives a token and every webhook delivery is refused.
# README.md, "GitHub", says how to create the App.
INFERATIVE_CONNECTORS_GITHUB_APP_ID=
INFERATIVE_CONNECTORS_GITHUB_APP_PRIVATE_KEY=
INFERATIVE_CONNECTORS_GITHUB_WEBHOOK_SECRET=

# The origins of the websites of your channels, as a JSON list. They may call the channel routes, and the visual
# editor frames them.
INFERATIVE_CHANNELS_ADMINISTRATION_ORIGINS=

# The driver of the assistant: demo or connections. In production both call a model through the model connections:
# AI turns on for each organization that adds a model connection (Organization > Models), or reaches one below. Empty
# or demo, a local run answers with a scripted stand-in.
INFERATIVE_ASSISTANT_BACKEND_DRIVER=

# The deployment's own model connections, as a JSON list, used only while the platform organization (the first
# organization) has no model connection of its own: add one under Organization > Models instead, and this list is not
# read. Each entry holds a secret key: set it here and in .env.worker, never in a committed file. The kind is anthropic, openai, vercel-ai-gateway, cloudflare-ai-gateway or
# openrouter. Example:
# [{"name":"Anthropic","kind":"anthropic","credential":{"key":"<anthropic-api-key>"},"model":"claude-sonnet-5-5"}]
# A gateway entry lists the model creators it reaches and a creator/model id, for example
# [{"name":"Gateway","kind":"vercel-ai-gateway","upstreams":["anthropic"],"credential":{"key":"<gateway-key>"},"model":"anthropic/claude-sonnet-5-5"}]
INFERATIVE_MODELS_DEPLOYMENT_CONNECTIONS=

# ---- Local run only. None of these values goes to the Worker. ----

# The direct connection string of the database. A local run reads and writes the hosted database over it.
# Migrations run over it when the app starts, and in CI before each deploy. The Worker uses Hyperdrive instead.
DATABASE_URL=

# Do not run the scheduled jobs in a local run: only the deployed Worker has a cron trigger.
HEXIMON_SCHEDULE=off

# The public origin of the local run. The OAuth issuer, the passkey settings and every address of the API derive from
# it. The Worker gets its own https:// address: README.md, "Secrets".
INFERATIVE_APP_ORIGIN=http://localhost:3000

# Local development reaches the R2 bucket of the dashboard through its S3 API. Create an R2 access key in the
# Cloudflare dashboard (R2 object storage, Manage API tokens, Create API token): Object Read & Write on this bucket
# only. The dashboard shows the key id and the secret once. The account id is on the R2 overview page. With none of
# the four set, a local run keeps files in memory and prints one warning. Set all four or none. The Worker uses the
# bucket binding instead; the nightly backup workflow reads the same four values from the repository secrets.
INFERATIVE_FILES_R2_ACCOUNT_ID=
INFERATIVE_FILES_R2_BUCKET=
INFERATIVE_FILES_R2_ACCESS_KEY_ID=
INFERATIVE_FILES_R2_SECRET_ACCESS_KEY=
