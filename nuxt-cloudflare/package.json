{
  "name": "my-inferative-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:preview": "CLOUDFLARE_ENV=preview nuxt build",
    "typecheck": "nuxt typecheck",
    "heximon:check": "heximon check",
    "db:generate": "NODE_ENV=development drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "sync:manifest": "inferative site sync",
    "deploy:live": "node deploy/assert-worker.mjs live && wrangler deploy --config .output/server/wrangler.json",
    "deploy:preview": "node deploy/assert-worker.mjs preview && wrangler deploy --config .output/server/wrangler.json",
    "backup": "inferative backup",
    "test": "vitest --run"
  },
  "dependencies": {
    "@heximon/blob": "0.16.1",
    "@heximon/nitro": "0.16.1",
    "@heximon/nuxt": "0.16.1",
    "@heximon/primitives": "0.16.1",
    "@heximon/queue": "0.16.1",
    "@inferative/activity": "^0.1.0",
    "@inferative/base": "^0.1.0",
    "@inferative/channels": "^0.1.0",
    "@inferative/content": "^0.1.0",
    "@inferative/dashboard": "^0.1.0",
    "@inferative/files": "^0.1.0",
    "@inferative/identity": "^0.1.0",
    "@inferative/localization": "^0.1.0",
    "@inferative/notifications": "^0.1.0",
    "@inferative/pages": "^0.1.0",
    "@inferative/publishing": "^0.1.0",
    "@inferative/search": "^0.1.0",
    "@inferative/seo": "^0.1.0",
    "@inferative/site": "^0.1.0",
    "@inferative/visual-editing": "^0.1.0",
    "@inferative/workspace": "^0.1.0",
    "@nuxt/kit": "npm:@nuxt/kit-nightly@^5.0.0-29814535.1ceb443f",
    "@nuxt/schema": "npm:@nuxt/schema-nightly@^5.0.0-29814535.1ceb443f",
    "ai": "^7.0.127",
    "mysql2": "^3.24.4",
    "nuxt": "npm:nuxt-nightly@^5.0.0-29814535.1ceb443f",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
