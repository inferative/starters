# The variables of a local run. Copy this file to `.env` and fill it. Never commit `.env`.
# A deployed Worker takes its secrets from `wrangler secret bulk`, not from this file.
# Any package setting changes through INFERATIVE_<SECTION>_<PATH> (upper snake case; a list takes JSON).

# The direct connection string of the database. A local run reads and writes the hosted database over it.
# Migrations run over it when the app starts, and in CI before each deploy. The Worker uses Hyperdrive instead.
DATABASE_URL=

# Do not run the scheduled jobs in a local run: only the live Worker has a cron trigger.
HEXIMON_SCHEDULE=off

# The public origin of the site. The OAuth issuer and every address of the API derive from it.
INFERATIVE_APP_ORIGIN=http://localhost:3000

# The root secret: 32 random bytes, base64. The setup token and the signing keys of preview links derive from it, so
# their own variables below may stay empty. A variable of its own wins over the root. The MFA key derives from it
# too, and there the root wins: an MFA key that you set before only decrypts, until each secret is sealed again at its
# next use. A backup restores only with the same root, or with the older MFA key. To rotate the root, move the old
# value to INFERATIVE_ROOT_SECRET_PREVIOUS: the links that it signed keep working, its MFA key still decrypts, and
# nothing new is signed or sealed with it. Keep the previous value until `pnpm mfa:reseal` reports no remaining secret
# and no account mail queued before the rotation still waits in the outbox, and for as long as you may restore a backup
# from before the rotation (README.md, "Cloudflare").
# `pnpm exec inferative setup-token` prints the setup token that the root gives.
INFERATIVE_ROOT_SECRET=

# The ES256 key that signs sessions and tokens (a base64 private JWK).
INFERATIVE_IDENTITY_SIGNING_KEY=

# The AES-256 key (base64url, 32 bytes) that sealed the secrets of two-factor sign-in before the root. Empty for a new
# site: it derives from INFERATIVE_ROOT_SECRET. Set, with the root: it only decrypts, and a secret is sealed again
# under the root's key at its next use. `pnpm mfa:reseal` seals every secret again at once; remove the key when it
# reports no remaining secret and no account mail queued before the change still waits in the outbox.
INFERATIVE_IDENTITY_MFA_ENCRYPTION_KEY=

# The one-time token that the first-run step of the sign-in page asks for. Empty: it derives from
# INFERATIVE_ROOT_SECRET.
INFERATIVE_IDENTITY_SETUP_TOKEN=

# The list of signing keys of preview links: [{ "kid": "key-1", "secret": "<base64url secret>" }]. The first signs.
# Empty: it derives from INFERATIVE_ROOT_SECRET.
INFERATIVE_BASE_SIGNED_ACCESS_SIGNING_KEYS=

# Set to true to run one organization: the first-run step creates it and nobody creates another.
INFERATIVE_IDENTITY_ORGANIZATION_SINGLE_ORGANIZATION=true

# The id of the organization of the first-run step. Set it after the first sign-in, then restart. The public
# site reads the default channel of this organization.
INFERATIVE_CHANNELS_DEFAULT_ORGANIZATION_ID=

# The address that every mail of the site comes from: an invitation, a password reset. Your mail provider must
# accept it. With no provider, no mail goes out, and a local run prints each mail and its links in the log. To add a
# provider, read "Send email" in README.md. It adds the provider key INFERATIVE_MAIL_RESEND_API_KEY.
INFERATIVE_NOTIFICATIONS_SENDER_EMAIL=

# The passkey settings: the registrable domain, and the list of origins that a sign-in may come from.
INFERATIVE_IDENTITY_WEBAUTHN_RP_ID=localhost
INFERATIVE_IDENTITY_WEBAUTHN_ALLOWED_ORIGINS=["http://localhost:3000"]

# Leave INFERATIVE_API_BASE_URL unset or empty: this site serves its own API. A value makes the
# dashboard send no sign-in cookies. The Connect the website guide of a channel copies a line for it: do not paste it.
# INFERATIVE_API_BASE_URL=

# `inferative site sync` only: the key that publishes the manifest, and the API origin with /api.
INFERATIVE_MANIFEST_TOKEN=
INFERATIVE_SITE_SYNC_API_BASE_URL=http://localhost:3000/api
INFERATIVE_SITE_SYNC_CHANNEL_ID=

# Local development reaches the R2 bucket of the site through its S3 API. Create an R2 access key in the
# Cloudflare dashboard (R2 object storage, Manage API tokens, Create API token): Object Read & Write on this bucket
# only. The dashboard shows the key id and the secret once. The account id is on the R2 overview page. With none of
# the four set, a local run keeps files in memory and prints one warning. Set all four or none.
INFERATIVE_FILES_R2_ACCOUNT_ID=
INFERATIVE_FILES_R2_BUCKET=
INFERATIVE_FILES_R2_ACCESS_KEY_ID=
INFERATIVE_FILES_R2_SECRET_ACCESS_KEY=
